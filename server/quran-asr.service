[Unit]
Description=Quran recitation recognition (whisper-base-ar-quran)
After=network-online.target
Wants=network-online.target

[Service]
User=quran-asr
WorkingDirectory=/opt/quran-asr
Environment=HF_HOME=/var/lib/quran-asr/hf
Environment=ASR_THREADS=3
ExecStart=/opt/quran-asr/venv/bin/uvicorn asr:app --app-dir /opt/quran-asr --host 127.0.0.1 --port 8090 --workers 1
Restart=always
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/quran-asr
PrivateTmp=true
MemoryMax=6G

[Install]
WantedBy=multi-user.target
